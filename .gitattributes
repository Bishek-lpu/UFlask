# Git Attributes for uFlask
# Ensures consistent line endings and diff output

# Default: auto line endings
* text=auto

# Python files
*.py    text eol=lf diff=python

# Markdown
*.md    text eol=lf diff=markdown

# Config files
*.yml   text eol=lf
*.yaml  text eol=lf
*.toml  text eol=lf
*.cfg   text eol=lf
*.ini   text eol=lf
*.txt   text eol=lf

# Shell scripts
*.sh    text eol=lf

# HTML / CSS / JS
*.html  text eol=lf
*.css   text eol=lf
*.js    text eol=lf

# Binary files — don't touch line endings
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.uf2   binary
*.mpy   binary
*.bin   binary
*.zip   binary
*.gz    binary
*.whl   binary

# GitHub linguist — mark examples as documentation
examples/**     linguist-documentation=true
docs/**         linguist-documentation=true
templates_example/** linguist-documentation=true
